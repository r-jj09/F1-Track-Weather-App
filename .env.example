# OpenWeather One Call 3.0 key. Only used by the /api/weather server function,
# it is not bundled into the browser code.
OPENWEATHER_API_KEY=your_api_key_here

# Shared weather cache (Upstash Redis from the Vercel Marketplace sets these for you).
# Without them the cache only lives inside each server instance.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
